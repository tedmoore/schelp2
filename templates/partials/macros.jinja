{% macro render_inline(inline_content) -%}
{%- for item in inline_content -%}
{%- if item.type == 'text' -%}
{{ item.content }}
{%- elif item.type == 'link' -%}
[{{ item.text }}](#{{ item.target | replace('Classes/', '') | replace('/', '-') }})
{%- elif item.type == 'inline_code' -%}
`{{ item.content }}`
{%- elif item.type == 'emphasis' -%}
*{{ item.content }}*
{%- elif item.type == 'strong' -%}
**{{ item.content }}**
{%- endif -%}
{%- endfor -%}
{%- endmacro %}

{% macro render_content(content_list) -%}
{%- for item in content_list -%}

{%- if item.type == 'paragraph' -%}
{{ _self.render_inline(item.content) }}

{%- elif item.type == 'code_block' -%}
```
{{ item.content }}
```

{%- elif item.type == 'section' -%}
## {{ item.title }}

{{ _self.render_content(item.content) }}

{%- elif item.type == 'subsection' -%}
### {{ item.title }}

{{ _self.render_content(item.content) }}

{%- elif item.type == 'method' -%}
### `{{ item.name }}`

{%- if item.arguments %}

**Arguments:**

| Argument | Description |
|----------|-------------|
{%- for arg in item.arguments %}
| `{{ arg.name }}` | {% for desc in arg.description %}{{ _self.render_inline(desc) }}{% endfor %} |
{%- endfor %}
{%- endif %}

{%- if item.returns %}

**Returns:** {% for ret in item.returns %}{{ _self.render_inline(ret) }}{% endfor %}
{%- endif %}

{%- if item.content %}
{{ _self.render_content(item.content) }}
{%- endif %}

{%- elif item.type == 'argument' -%}
- `{{ item.name }}` - {{ _self.render_content(item.content) }}

{%- elif item.type == 'admonition' -%}
{% if item.admonition_type == 'note' %}
> **Note:** {{ _self.render_content(item.content) }}
{% elif item.admonition_type == 'warning' %}
> **⚠️ Warning:** {{ _self.render_content(item.content) }}
{% endif %}

{%- elif item.type == 'definition_list' -%}
{%- for def_item in item['items'] %}
- **{{ _self.render_inline(def_item.term) }}** - {{ _self.render_inline(def_item.definition) }}
{%- endfor %}

{%- elif item.type == 'list' or item.type == 'numbered_list' -%}
{%- for list_item in item['items'] %}
{% if item.type == 'numbered_list' %}{{ loop.index }}.{% else %}-{% endif %} {{ _self.render_inline(list_item) }}
{%- endfor %}

{%- elif item.type == 'list_item' -%}
- {{ _self.render_inline(item.content) }}

{%- elif item.type == 'image' -%}
![{{ item.caption }}]({{ item.path }})
{% if item.caption %}*{{ item.caption }}*{% endif %}

{%- elif item.type == 'blank_line' -%}

{%- endif -%}

{%- endfor -%}
{%- endmacro %}
